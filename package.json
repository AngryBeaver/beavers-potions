{
  "name": "beavers-potions",
  "title": "Beaver's Potions",
  "version": "3.0.0",
  "description": "50 additional magical potions for dnd5e, with recipes for Beaver's Crafting",
  "devDir": "c:\\vtts\\v12.331\\Data\\modules",
  "#devDir": "c:\\vtts\\v11.315\\Data\\modules",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs build",
    "watch": "node build.mjs watch",
    "clean": "node build.mjs clean",
    "devbuild": "node build.mjs dev",
    "devwatch": "node build.mjs devwatch",
    "release": "node build.mjs zip",
    "packs:extract": "node tools/extract-packs.mjs",
    "tag": "git tag -d ${npm_package_name}_${npm_package_version} 2>/dev/null ; git tag ${npm_package_name}_${npm_package_version} && git push -f origin ${npm_package_name}_${npm_package_version}",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\"",
    "packs:generate": "node tools/generate-packs.mjs"
  },
  "prettier": {
    "tabWidth": 2,
    "semi": true,
    "quoteProps": "consistent",
    "trailingComma": "all",
    "printWidth": 120
  },
  "devDependencies": {
    "@ethaks/fvtt-quench": "^0.6.0",
    "@foundryvtt/foundryvtt-cli": "^1.1.0",
    "@league-of-foundry-developers/foundry-vtt-types": "^0.8.8-9",
    "@types/node": "^22.0.0",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.0"
}
