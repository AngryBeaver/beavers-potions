    "itemacro": {
      "macro": {
        "name": "Casters Overtime",
        "type": "script",
        "scope": "global",
        "command": "if(args[0] === \"off\"){\n      const actor = await fromUuid(args[1].actorUuid);\n      const prevActiveEffect = actor.effects.find((ae)=> ae.label.startsWith(\"Exhaustion\"));\n      let effectName = \"Exhaustion 1\";\n      if(prevActiveEffect !== undefined){\n        if(prevActiveEffect.label.endsWith(\"1\")){effectName=\"Exhaustion 2\";}\n        else if(prevActiveEffect.label.endsWith(\"2\")){effectName=\"Exhaustion 3\";}\n        else if(prevActiveEffect.label.endsWith(\"3\")){effectName=\"Exhaustion 4\";}\n        else if(prevActiveEffect.label.endsWith(\"4\")){effectName=\"Exhaustion 5\";}\n        else {effectName=\"Dead\";}\n        prevActiveEffect.delete();\n      }\n      const activeEffect = game.dfreds.effectInterface.findEffectByName(effectName);\n      await actor.createEmbeddedDocuments('ActiveEffect', [activeEffect.convertToActiveEffectData()]);\n      await actor.update({system:{spells:{\n        spell2:{value:actor.system.spells.spell2.max},\n        spell1:{value:actor.system.spells.spell1.max}\n      }}});\n    }",
