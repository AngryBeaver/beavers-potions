        "scope": "global",
        "command": "if(args[0] === \"on\"){\n  const actor = await fromUuid(args[1].actorUuid);\n  const nextActor = await game.packs.get(\"dnd5e.monsters\").getDocument(\"1zzRQps9jZdLZGqI\");\n  const polymorphedActor = await actor.transformInto(nextActor);\n  const actorUpdate = {};\n  actorUpdate[\"flags.beavers-potions.polymorphed\"] = polymorphedActor[0]._actor.uuid\n  await actor.update(actorUpdate);\n  await polymorphedActor[0]._actor.update(actorUpdate);\n}\nif(args[0] === \"off\"){\n  const actor = await fromUuid(args[1].actorUuid);\n  console.log(actor);\n  console.log(actor.flags[\"beavers-potions\"].polymorphed);\n  const polymorphedActor = await fromUuid(actor.flags[\"beavers-potions\"].polymorphed);\n  console.log(polymorphedActor);\n  await polymorphedActor.revertOriginalForm()\n}",
