    "itemacro": {
      "macro": {
        "name": "FrostArmor Greater",
        "type": "script",
        "scope": "global",
        "command": "const tempHp = (2*args[1]);\nconsole.log(args);\nif(args[0] === \"on\"){\n  const actorData = await fromUuid(args[2].actorUuid);\n  const actorUpdate = {};\n  actorUpdate[\"flags.beavers-potions.frostArmor.base\"] = actorData.system.attributes.hp.temp;\n  actorUpdate[\"flags.beavers-potions.frostArmor.next\"] = actorData.system.attributes.hp.temp + tempHp;\n  actorUpdate[\"system.attributes.hp.temp\"] = actorUpdate[\"flags.beavers-potions.frostArmor.next\"];\n  await actor.update(actorUpdate);\n}\nif(args[0] === \"each\"){\n  const actorData = await fromUuid(args[2].actorUuid);\n  if(actorData.system.attributes.hp.temp<actorData.flags[\"beavers-potions\"].frostArmor.next){\n    const actorUpdate = {};\n    actorUpdate[\"system.attributes.hp.temp\"] = actorData.flags[\"beavers-potions\"].frostArmor.next;\n    await actor.update(actorUpdate);\n  }\n}\nif(args[0] === \"off\"){\n  const actorData = await fromUuid(args[2].actorUuid);\n  const actorUpdate = {};\n  if(actorData.system.attributes.hp.temp<=actorData.flags[\"beavers-potions\"].frostArmor.next && \n    actorData.system.attributes.hp.temp>actorData.flags[\"beavers-potions\"].frostArmor.base\n  ){\n    actorUpdate[\"system.attributes.hp.temp\"] = actorData.flags[\"beavers-potions\"].frostArmor.base\n    await actor.update(actorUpdate);\n  }else \n  if(actorData.system.attributes.hp.temp>actorData.flags[\"beavers-potions\"].frostArmor.next){\n    const diff = actorData.flags[\"beavers-potions\"].frostArmor.next-actorData.flags[\"beavers-potions\"].frostArmor.base;\n    actorUpdate[\"system.attributes.hp.temp\"] = actorData.system.attributes.hp.temp-diff; \n    await actor.update(actorUpdate);\n  }\n}",
